{
  "manifest_version": 3,
  "name": "見積もり逆算スキャナー",
  "short_name": "Estimate Scanner",
  "version": "0.1.0",
  "description": "参考サイトのページ数（sitemap.xml）・テンプレート・フォーム・多言語・動き・技術を読み取り、見積もりのたたき台を作成。Excelにそのまま貼れます",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "見積もり逆算スキャナーを開く",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
